# =============================================================================
# Backend Environment Configuration Template (Module 1)
# Copy this file to .env or export these variables in your shell.
# =============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_water_management
DB_USERNAME=water_admin
DB_PASSWORD=your_secure_password_here

# Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Flyway Migrations
FLYWAY_ENABLED=true

# Hibernate SQL Logging (set to true only for local SQL debugging)
SPRING_JPA_SHOW_SQL=false

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
