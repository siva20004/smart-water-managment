# =============================================================================
# Root .gitignore — Smart Water Management & Database Analytics System
# =============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment Variables & Secrets (CRITICAL: Never commit real credentials)
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# IDEs and Code Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# Java & Maven Artifacts
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*

# Node.js & React Frontend Artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker & Container Mounts
docker/postgres_data/
*.pid

# Database Dumps and Backups
database/backups/
*.dump

# Temporary Scratch Files
temp/
tmp/
*.tmp
